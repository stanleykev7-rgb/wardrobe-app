# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Cloudflare R2 (free tier: 10GB storage, zero egress fees)
# Create a bucket + API token at https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=wardrobe-app
# The public URL for your bucket (enable "Public Access" -> r2.dev subdomain
# in bucket settings, or use a custom domain)
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Optional
FLASK_SECRET_KEY=change-me-to-something-random
DEFAULT_CITY=Kochi,IN
GROQ_VISION_MODEL=qwen/qwen3.6-27b
