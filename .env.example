# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Get a free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Supabase (free tier, no credit card required)
# Create a project at https://supabase.com/dashboard, then:
# - Project Settings -> API -> Project URL           -> SUPABASE_URL
# - Project Settings -> API -> service_role secret key -> SUPABASE_KEY
#   (service_role, not anon - this app runs server-side only, so it's safe
#   to use the privileged key here; never expose it to a browser/frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_service_role_key_here
SUPABASE_BUCKET=wardrobe-photos

# Optional
FLASK_SECRET_KEY=change-me-to-something-random
DEFAULT_CITY=Kochi,IN
GROQ_VISION_MODEL=qwen/qwen3.6-27b
